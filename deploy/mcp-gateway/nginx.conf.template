# Authenticating gateway in front of the deck MCP server.
#
# LibreChat v0.8.9-rc1 does not send `headers:` on the MCP transport and treats any 401 as "needs
# OAuth", so a shared bearer cannot be delivered by LibreChat itself. This gateway holds the token
# instead: LibreChat talks plain HTTP to it over the private docker network, the gateway injects the
# Authorization header, and the MCP server still validates every request (token mode). The credential
# never reaches the model, the browser, or the LAN.
worker_processes  1;
error_log  /dev/stderr warn;
pid        /tmp/nginx.pid;

events { worker_connections 256; }

http {
  access_log off;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path       /tmp/proxy;
  fastcgi_temp_path     /tmp/fastcgi;
  uwsgi_temp_path       /tmp/uwsgi;
  scgi_temp_path        /tmp/scgi;

  # streamable-http MCP needs unbuffered streaming for its SSE responses
  proxy_http_version 1.1;
  proxy_buffering off;
  proxy_request_buffering off;
  chunked_transfer_encoding on;
  proxy_read_timeout 300s;
  proxy_send_timeout 300s;
  proxy_connect_timeout 10s;

  server {
    listen 8931;
    server_name _;

    location / {
      proxy_pass http://${MCP_UPSTREAM};
      proxy_set_header Host ${MCP_UPSTREAM_HOST};
      proxy_set_header Authorization "Bearer ${MCP_TOKEN}";
      proxy_set_header Connection "";
      proxy_set_header X-Forwarded-For "";
      proxy_set_header X-Real-IP "";
    }

    location = /gateway-health {
      default_type text/plain;
      return 200 "ok\n";
    }
  }
}
