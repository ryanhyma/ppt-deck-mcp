{
  "realm": "deck",
  "enabled": true,
  "displayName": "Deck MCP (Entra-shaped test realm)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "Decks.Access", "description": "May use the deck tools" }
    ]
  },
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.gc.ca",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Tester",
      "credentials": [{ "type": "password", "value": "Alice!2026", "temporary": false }],
      "realmRoles": ["Decks.Access"]
    }
  ],
  "clients": [
    {
      "clientId": "librechat-deck-studio",
      "name": "LibreChat (MCP client)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3080/api/mcp/ppt-oidc/oauth/callback",
        "http://127.0.0.1:3080/api/mcp/ppt-oidc/oauth/callback"
      ],
      "webOrigins": ["http://localhost:3080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["openid", "profile", "email", "deck-audience", "entra-shape"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "deck-service",
      "name": "Service token (CI / smoke)",
      "enabled": true,
      "publicClient": false,
      "secret": "deck-service-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": ["deck-audience", "entra-shape"]
    }
  ],
  "clientScopes": [
    {
      "name": "deck-audience",
      "description": "Puts this API in the token audience, like Entra's `aud`",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "aud=api://deck-mcp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "api://deck-mcp",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "entra-shape",
      "description": "Claims Entra issues and this server validates (tid, ver, scp, roles)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "tid", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tid", "claim.value": "11111111-1111-1111-1111-111111111111",
            "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false"
          }
        },
        {
          "name": "ver", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "ver", "claim.value": "2.0",
            "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false"
          }
        },
        {
          "name": "scp", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "scp", "claim.value": "Decks.Read",
            "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false"
          }
        },
        {
          "name": "roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles", "jsonType.label": "String", "multivalued": "true",
            "access.token.claim": "true", "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
