# Environment for the Windows service (NSSM: `nssm set PPTDeckMCP AppEnvironmentExtra ...`).
# Copy the KEY=VALUE pairs you need; keep secrets out of source control.

# --- paths -------------------------------------------------------------------
PPT_OUTPUT_DIR=C:\Services\ppt-mcp\data
PPT_UPLOAD_DIR=C:\Services\ppt-mcp\data\uploads\decks
PPT_TEMPLATE_PATH=C:\Services\ppt-mcp\templates
SOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe

# Interpreter that can `import uno` (LibreOffice's own python.exe). Blank = cold PDF chain.
PPT_UNO_PYTHON=C:\Program Files\LibreOffice\program\python.exe

# Origin the *browser* uses to reach this server. It must be a hostname, not an IP literal:
# LibreChat's MCP App bridge refuses IP-literal targets (Download button stops working).
PPT_PUBLIC_BASE=https://decks.corp.example.gc.ca:8931

# --- rendering ---------------------------------------------------------------
PPT_PREVIEW_WIDTH=1600
PPT_WARM_RENDER=1
PPT_RENDER_CACHE=1
PPT_RENDER_CACHE_MAX=5000
PPT_RENDER_QUEUE_MAX=256
PPT_RENDER_TIMEOUT_S=180

# --- authentication (see docs/authz-model.md) --------------------------------
# none    : no auth. Development only; the server refuses this when PPT_ENV=prod.
# token   : shared bearer token (LibreChat `headers: Authorization: Bearer ${PPT_MCP_TOKEN}`).
# entra   : validate Entra ID access tokens (aud = this API, tid = our tenant).
PPT_AUTH_MODE=entra
PPT_ENV=prod
# The bearer the MCP client (LibreChat) sends on every /mcp request:
#   headers: { Authorization: 'Bearer ${PPT_MCP_TOKEN}' }
PPT_MCP_TOKEN=
# Air-gapped validation only: a static tenant JWKS document.
PPT_ENTRA_JWKS_JSON=
PPT_ENTRA_JWKS_URL=
PPT_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# v2 tokens carry the API's client id in `aud`; v1 tokens carry the app ID URI.
PPT_ENTRA_AUDIENCE=00000000-0000-0000-0000-000000000000
# Comma-separated delegated scopes / app roles that may use the deck tools.
PPT_ENTRA_REQUIRED_SCOPES=Decks.Read
PPT_ENTRA_REQUIRED_ROLES=Decks.Access

# --- access control (see docs/security.md) -----------------------------------
# Extra roots a deck may be read from, besides output/upload/template dirs. Keep this empty in prod.
PPT_ALLOWED_ROOTS=
# HMAC key for signed slide-download URLs. Unset = random per process, so links die on restart.
PPT_URL_SECRET=

# --- housekeeping ------------------------------------------------------------
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
